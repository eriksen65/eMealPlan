{
    "name": "emealplan",
    "version": "0.0.1",
    "description": "eMealPlan - plan meals, generate shopping lists and run your daily cooking plan",
    "private": true,
    "workspaces": [
        "packages/domain",
        "packages/server",
        "packages/web"
    ],
    "scripts": {
        "dev:server": "npm run dev --workspace packages/server",
        "dev:web": "npm run dev --workspace packages/web",
        "build": "npm run build --workspaces --if-present",
        "test": "npm run test --workspaces --if-present",
        "test:watch": "npm run test:watch --workspace packages/domain",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --check \"packages/**/src/**/*.{ts,tsx,js,jsx,css,md,json}\" --config ./.prettierrc.json",
        "format:fix": "prettier --write \"packages/**/src/**/*.{ts,tsx,js,jsx,css,md,json}\" --config ./.prettierrc.json",
        "check": "npm run format && npm run lint && npm run test && npm run build"
    },
    "devDependencies": {
        "@eslint/js": "^9.17.0",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-react-hooks": "^5.1.0",
        "eslint-plugin-react-refresh": "^0.4.16",
        "globals": "^15.14.0",
        "prettier": "^3.4.2",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.19.1"
    },
    "engines": {
        "node": ">=20.19"
    }
}
