{
    "name": "@emealplan/server",
    "version": "0.0.1",
    "description": "eMealPlan Node.js/TypeScript backend: REST API over the domain layer, backed by JSON file repositories",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "start": "tsx src/index.ts",
        "build": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@emealplan/domain": "*",
        "@fastify/cors": "^10.0.2",
        "fastify": "^5.2.0"
    },
    "devDependencies": {
        "@types/node": "^22.10.5",
        "tsx": "^4.19.2",
        "vitest": "^2.1.8"
    }
}
